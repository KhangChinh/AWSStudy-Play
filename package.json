{
  "name": "study-play",
  "private": true,
  "version": "1.0.1",
  "author": "Uchimi",
  "description": "Study Play desktop application",
  "type": "module",
  "main": "electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "upload:frames": "node scripts/upload-avatar-frames.mjs",
    "lint": "eslint src && npm run lint:i18n",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "preview": "vite preview",
    "dev:desktop": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:desktop": "npm run build && electron-builder",
    "start": "npm run dev:desktop"
  },
  "build": {
    "appId": "com.studyplay.app",
    "productName": "Study Play",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "win": {
      "icon": "build/icon.png",
      "signtoolOptions": {
        "publisherName": "Uchimi"
      },
      "target": [
        "nsis"
      ]
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      ".env"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "browser-extension",
        "to": "extension"
      }
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-store": "^11.0.2",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1052.0",
    "@aws-sdk/lib-dynamodb": "^3.1052.0",
    "@eslint/js": "^10.0.1",
    "@ionic/react": "^8.8.7",
    "@vitejs/plugin-react": "^6.0.1",
    "aws-amplify": "^6.17.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "ionicons": "^8.0.13",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1",
    "react-toastify": "^11.1.0",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "sass": "^1.99.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}